    "import cv2\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e1babaf0-7601-4439-91f9-19edf0928f11",
   "metadata": {},
   "outputs": [],
   "source": [
    "img = cv2.imread(\"Jay Shri Ram.jpg\")\n",
    "re_img = cv2.resize(img,(300,300))\n",
    "h = np.hstack((re_img, re_img))\n",
    "v = np.vstack((h,h))\n",
    "cv2.imshow(\"God\", v)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
